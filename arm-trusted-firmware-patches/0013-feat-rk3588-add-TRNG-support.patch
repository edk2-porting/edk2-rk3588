@@ -109,6 +109,7 @@
 #define SDMMC_BASE		0xfe2c0000
 #define SDIO_BASE		0xfe2d0000
 #define EMMC_BASE		0xfe2e0000
+#define TRNG_BASE		0xfe378000
 #define KEYLADDER_BASE		0xfe380000
 #define CRYPTO_S_BASE		0xfe390000
