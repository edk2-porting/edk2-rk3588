diff --git a/plat/rockchip/rk3588/rk3588_trng.c b/plat/rockchip/rk3588/rk3588_trng.c
new file mode 100644
index 000000000..e64bc6128
--- /dev/null
+++ b/plat/rockchip/rk3588/rk3588_trng.c
@@ -0,0 +1,126 @@
+/*
