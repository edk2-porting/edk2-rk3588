 .../boards/rk3588_reference_pmic/board.c      |   8 +
 plat/rockchip/rk3588/plat_sip_calls.c         |  27 ++
 plat/rockchip/rk3588/plat_sip_sdmmc.c         | 384 ++++++++++++++++++
 plat/rockchip/rk3588/plat_sip_sdmmc.h         |  21 +
 plat/rockchip/rk3588/platform.mk              |   1 +
 plat/rockchip/rk3588/rk3588_def.h             |   3 +
 7 files changed, 478 insertions(+), 3 deletions(-)
