[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = Fusb302Dxe
  FILE_GUID                      = 6e2d1f83-4a97-4c0e-9b45-c3f8a1d27e64
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = Fusb302Initialize

[Sources.common]
  Fusb302Dxe.c
  Fusb302Pd.c
  Fusb302Vdm.c
  Fusb302Source.c

[Packages]
  MdePkg/MdePkg.dec
  Silicon/Rockchip/RockchipPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  TimerLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Protocols]
  gEfiI2cIoProtocolGuid                 ## CONSUMES
  gFusb302PlatformDeviceProtocolGuid    ## CONSUMES
  gEfiDriverBindingProtocolGuid         ## PRODUCES
  gUsbTypeCPortProtocolGuid             ## PRODUCES

[Depex]
  #
  # The board has to have described its ports before the driver can tell
  # whether an I2C device it is offered is one of them.
  #
  gFusb302PlatformDeviceProtocolGuid
